{
	"name": "akash19jan/wp-environment-guard",
	"description": "Non-destructive safety policies for non-production WordPress environments.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Akash Agrawal",
			"homepage": "https://github.com/Akash19jan"
		}
	],
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"automattic/vipwpcs": "^3.1",
		"php-parallel-lint/php-parallel-lint": "^1.4",
		"php-stubs/wp-cli-stubs": "^2.12",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpunit/phpunit": "^11.5",
		"szepeviktor/phpstan-wordpress": "^2.0"
	},
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"autoload-dev": {
		"classmap": [
			"tests/unit/"
		]
	},
	"scripts": {
		"lint:php": "parallel-lint --exclude vendor --exclude node_modules .",
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"test": "phpunit",
		"check": [
			"@lint:php",
			"@phpcs",
			"@phpstan",
			"@test"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"audit": {
			"abandoned": "fail"
		},
		"optimize-autoloader": true,
		"sort-packages": true
	}
}
